{
  "name": "nifty50online-dev",
  "version": "0.1.0",
  "description": "Dev helper to serve the static NIFTY50LIVE trading app locally",
  "private": true,
  "scripts": {
    "start": "serve . -p 8000",
    "serve:proxy": "node server.js",
    "dev": "concurrently \"npm run start\" \"npm run serve:proxy\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "serve": "^14.2.0",
    "concurrently": "^8.0.1"
  }
}
